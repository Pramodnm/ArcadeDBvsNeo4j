# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust variables as required
# ==============================================================================

# ArcadeDB Configuration
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASSWORD=arcadepassword
ARCADEDB_DATABASE=EnterpriseTopology
BOLT_URI=bolt://localhost:7687

# Neo4j Configuration
NEO4J_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_BOLT_URI=bolt://localhost:7688

# LLM / GraphRAG Provider Configuration (OpenAI-compatible)
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
